    "bin/codex-exec.js",
    "bin/migrate-to-termux-pkg.js",
    "bin/codex",
    "bin/codex-exec",
    "bin/codex.bin",
    "bin/codex-code-mode-host",
    "bin/libc++_shared.so",
    "codex-package.json",
    "scripts/postinstall_termux_launcher.js",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "codex",
    "openai",
    "termux",
    "android",
    "arm64",
